// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String      @unique
  emailVerified Boolean     @default(false)
  image         String?
  lat           Float?
  lng           Float?
  location      Unsupported("geography(Point, 4326)")?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  // Auth relations
  sessions      Session[]
  accounts      Account[]
  
  // Game relations
  visits        Visit[]
  badges        UserBadge[]
  scores        Score[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Badge {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?  // SVG name or path
  criteria    Json?    
  createdAt   DateTime @default(now())
  
  // Relations
  users       UserBadge[]

  @@map("badge")
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  unlockedAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id])
  badge     Badge    @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@map("user_badge")
}

model Checkpoint {
  id          String   @id @default(cuid())
  name        String   // Nom de l'établissement (ex: "Le Café des Sports")
  description String?
  type        String   @default("OTHER") // RESTAURANT, CULTURE, STATION, etc.
  address     String?
  lat         Float
  lng         Float
  location    Unsupported("geography(Point, 4326)")?
  createdAt   DateTime @default(now())
  
  // Relations
  machines    Machine[]
  visits      Visit[]

  @@map("checkpoint")
}

model Machine {
  id           String     @id @default(cuid())
  name         String     // Nom du flipper (ex: "The Addams Family")
  checkpointId String
  checkpoint   Checkpoint @relation(fields: [checkpointId], references: [id])
  createdAt    DateTime   @default(now())
  
  // Relations
  scores         Score[]
  pendingScores  PendingScore[]

  @@map("machine")
}

model Score {
  id        String   @id @default(cuid())
  value     Int
  userId    String
  machineId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  machine   Machine  @relation(fields: [machineId], references: [id])

  pendingScore  PendingScore?

  @@index([machineId, value(sort: Desc)])
  @@map("score")
}

model PendingScore {
  id           String             @id @default(cuid())
  gameId       String             @unique
  claimCode    String             @unique
  borneId      String
  score        Int
  timestamp    DateTime
  expiresAt    DateTime
  status       PendingScoreStatus @default(UNCLAIMED)
  claimedAt    DateTime?
  claimedBy    String?

  finalScoreId String?            @unique
  finalScore   Score?             @relation(fields: [finalScoreId], references: [id])

  machine      Machine            @relation(fields: [borneId], references: [id])

  @@index([status, expiresAt])
  @@index([claimCode])
  @@map("pending_score")
}

enum PendingScoreStatus {
  UNCLAIMED
  CLAIMED
  EXPIRED
}

model Visit {
  id           String     @id @default(cuid())
  userId       String
  checkpointId String
  visitedAt    DateTime   @default(now())
  
  user         User       @relation(fields: [userId], references: [id])
  checkpoint   Checkpoint @relation(fields: [checkpointId], references: [id])

  @@unique([userId, checkpointId, visitedAt])
  @@map("visit")
}
