FROM node:20-alpine
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000

# Le code vient du bind mount ; npm ci remplit le volume node_modules (Linux) au démarrage
CMD ["sh", "-c", "npm ci && npx prisma generate && exec npm run dev -- -H 0.0.0.0"]
