{
  "name": "pocket-maps-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @pocket-maps/client\" \"npm run dev -w @pocket-maps/server\" \"npm run dev -w @pocket-maps/gateway\"",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:push": "npm run db:push -w @pocket-maps/database",
    "db:generate": "npm run db:generate -w @pocket-maps/database",
    "db:seed": "npm run db:seed -w @pocket-maps/database",
    "docker:dev:up": "docker compose -f docker-compose.dev.yml up -d --build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "sonner": "^2.0.7"
  }
}